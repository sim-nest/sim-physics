  (primary [row Route(RouteRecord { id: RouteId("route/audit-analytic-switched-electrical-study"), title: "Audit a switched lumped electrical study against independent equations", audiences: ["code", "framework", "user"], steps: [Feature { id: FeatureId("feature/sim-physics/self-contained-analytic-studies"), why: "The cross-layer integration suite proves two oriented voltage/current ports, a discontinuity, terminal event, stiff interval, independent stores, refinement contraction, and a certified threshold." }, Specimen { id: SpecimenId("spec-test/sim-physics/crates/sim-lib-physics-core/tests/boundary_event"), why: "Check the common event/topology contract, then run the repository's analytic_studies and analytic_study_routes targets for the public equation-derived composition and metamorphic cases." }], doc_anchor: None })] [note "route/audit-analytic-switched-electrical-study"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/audit-conjugate-port-work"), title: "Audit signed continuous and impulsive work across physical boundaries", audiences: ["code", "framework", "user"], steps: [Feature { id: FeatureId("feature/sim-physics/boundary-event-core"), why: "Declare the boundary and crossing port identities." }, Feature { id: FeatureId("feature/sim-physics/conjugate-port-work"), why: "Pair effort and flow, orient the port, split continuous work at events, and retain impulses separately." }, Specimen { id: SpecimenId("spec-test/sim-physics/crates/sim-lib-physics-power/tests/work"), why: "The specimen proves analytic domains, orientation, discontinuities, simultaneous events, and pure impulses." }, Specimen { id: SpecimenId("recipe/sim-physics/01-power/switched-two-port"), why: "Run a switched electrical-to-mechanical two-port audit." }], doc_anchor: None })] [note "route/audit-conjugate-port-work"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/audit-independent-stored-energy"), title: "Audit stored-energy balance without deriving endpoint stores from transferred work", audiences: ["code", "framework", "user"], steps: [Feature { id: FeatureId("feature/sim-physics/conjugate-port-work"), why: "Retain signed continuous work and event transfers at the declared boundary." }, Feature { id: FeatureId("feature/sim-physics/stored-energy-audit"), why: "Evaluate both endpoint states constitutively and compute the visible balance with typed evidence lanes." }, Specimen { id: SpecimenId("spec-test/sim-physics/crates/sim-lib-physics-audit/tests/audit"), why: "The specimen proves independent perturbations, sign and omission failures, distinct residuals, and separated uncertainty." }, Specimen { id: SpecimenId("recipe/sim-physics/02-audit/stored-energy"), why: "Inspect the equation, Shapes, and runtime exports." }], doc_anchor: None })] [note "route/audit-independent-stored-energy"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/certify-physics-refinement"), title: "Distinguish numerical convergence from a certified mathematical-model verdict", audiences: ["code", "framework", "user"], steps: [Feature { id: FeatureId("feature/sim-physics/stored-energy-audit"), why: "Retain independent audit evidence lanes." }, Feature { id: FeatureId("feature/sim-physics/certified-orthogonal-refinement"), why: "Refine each assumption explicitly and require a sealed enclosure for definite claims; its crate integration tests prove sign reversal, non-monotonicity, independent failures, refusal of estimates, continuation diagnoses, and reproducible identity." }, Specimen { id: SpecimenId("recipe/sim-physics/03-proof/certified-refinement"), why: "Inspect event-exact meshing and runtime exports." }], doc_anchor: None })] [note "route/certify-physics-refinement"] [section "route"])
