  (primary [row Route(RouteRecord { id: RouteId("route/preserve-physics-finding-history"), title: "Preserve and investigate a surprising physics result without erasing competing explanations", audiences: ["code", "framework", "user"], steps: [Feature { id: FeatureId("feature/sim-physics/immutable-placement-studies"), why: "Produce reviewable sweep evidence and stable study identity." }, Feature { id: FeatureId("feature/sim-physics/immutable-finding-history"), why: "Publish the observation, append evidence-bearing successors, retain branches, and rebuild read-only projections from immutable records. Its crate integration suite proves identity, backend parity, interrupted and concurrent append, corruption refusal, branch reconciliation, rebuild, complete history, and redaction." }, Specimen { id: SpecimenId("recipe/sim-physics/06-findings/sweep-to-finding"), why: "Convert one sweep residual into an open finding." }], doc_anchor: None })] [note "route/preserve-physics-finding-history"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/refuse-energy-influenced-selection"), title: "Prove that a physical-study selection input is independent of energy", audiences: ["code", "framework", "user"], steps: [Feature { id: FeatureId("feature/sim-physics/no-energy-selection"), why: "Apply the fail-closed influence domain over the canonical incremental engine, protected sinks, native type-state, and runtime Shape preparation; its crate integration suite proves direct and laundered influence, branches, joins, loops, opaque code, clean preparation, budget refusal, and incremental edits." }, Specimen { id: SpecimenId("recipe/sim-physics/04-influence/refused-selection"), why: "Run a divide-by-time laundering refusal and inspect its causal path." }], doc_anchor: None })] [note "route/refuse-energy-influenced-selection"] [section "route"])
